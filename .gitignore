# Secrets and machine-specific settings
.env

# Data never goes into Git; the two documentation files are the exceptions
data/*
!data/README.md
!data/codebook.md

# Rebuildable or personal
output/logs/*
!output/logs/.gitkeep
scratch/

# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Stata (run.py moves batch logs to output/logs)
*.log
*.smcl

# LaTeX build files
paper/**/*.aux
paper/**/*.bbl
paper/**/*.blg
paper/**/*.fdb_latexmk
paper/**/*.fls
paper/**/*.out
paper/**/*.synctex.gz
paper/**/*.toc
paper/**/*.nav
paper/**/*.snm

# Operating systems
.DS_Store
Thumbs.db
