# Copy this file to .env and fill it in for your machine. .env is never committed.

# Where the project data lives (lab storage). A relative path is read from the project root.
DATA_DIR=data

# Stata executable, needed only if the project has .do files.
#   Mac:      /Applications/Stata/StataMP.app/Contents/MacOS/stata-mp
#   Windows:  C:\Program Files\Stata18\StataMP-64.exe
STATA_PATH=

# API keys for LLM calls. Leave empty if the project does not use them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
